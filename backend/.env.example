# ---------------------------------------------------------------- Database
DATABASE_URL=postgresql+psycopg2://parking:parking@localhost:5432/smart_parking
# Apply Alembic migrations automatically on startup
AUTO_MIGRATE=true

# ---------------------------------------------------------------- Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Initial super admin, created only when the users table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@parking.local

# ---------------------------------------------------------------- Cameras
CAMERA_WORKERS_ENABLED=true
# Run YOLO/OCR on every Nth frame of real cameras (raise on weak CPUs)
PROCESS_EVERY_N_FRAMES=3
RECONNECT_MIN_SECONDS=2
RECONNECT_MAX_SECONDS=60
STREAM_JPEG_QUALITY=70
STREAM_MAX_WIDTH=960

# ---------------------------------------------------------------- ANPR engine
# Requires: pip install -r requirements-ai.txt
YOLO_VEHICLE_MODEL=yolov8n.pt
# Optional licence-plate detector weights (e.g. a YOLOv8 model trained on plates)
YOLO_PLATE_MODEL=
# cpu | cuda:0
YOLO_DEVICE=cpu
VEHICLE_CONF_THRESHOLD=0.4
OCR_LANG=en
OCR_USE_GPU=false

# ---------------------------------------------------------------- Simulation
# true = run real YOLO+OCR on simulated frames instead of ground-truth detections
SIM_USE_REAL_ANPR=false
# Chance per minute that a simulated camera drops its stream (tests reconnect)
SIM_DISCONNECT_PROBABILITY=0.0

# Images storage (default: backend/media)
# MEDIA_DIR=/var/lib/smart-parking/media
